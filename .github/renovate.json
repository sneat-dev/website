{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>sneat-co/cicd",
    "schedule:weekly"
  ],
  "packageRules": [
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group dependencies managed by pnpm",
      "matchManagers": [
        "npm"
      ],
      "groupName": "pnpm dependencies"
    }
  ]
}
